{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://visual-script.dev/schemas/director-script.schema.json",
  "title": "DirectorScript",
  "description": "导演稿：LLM 产出的第一层语义产物，不含绝对时间。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "narrations", "elements", "cues"],
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "audience": { "type": "string" },
        "style": { "type": "string" },
        "fps": { "type": "integer", "minimum": 1, "default": 30 },
        "aspect": { "type": "string", "enum": ["16:9"], "default": "16:9" }
      }
    },
    "narrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "text": { "type": "string", "minLength": 1, "description": "口播文本，用 [[锚点文本]] 标记关键词" },
          "gapAfterMs": { "type": "number", "minimum": 0, "default": 350 },
          "minHoldMs": { "type": "number", "minimum": 0, "default": 0 }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "layer", "preset", "content"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "kind": { "const": "text" },
              "layer": { "type": "integer", "minimum": 0 },
              "preset": { "type": "string", "enum": ["title", "heading", "keyword", "subtitle", "body", "caption"] },
              "content": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "text"],
                    "properties": {
                      "type": { "const": "literal" },
                      "text": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "narrationId", "anchor"],
                    "properties": {
                      "type": { "const": "narration" },
                      "narrationId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "anchor": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              },
              "maxWidth": { "type": "number", "exclusiveMinimum": 0 },
              "align": { "type": "string", "enum": ["left", "center", "right"], "default": "center" },
              "slot": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top_left", "top_right", "bottom_left", "bottom_right"],
                "default": "center",
                "description": "语义槽位：元素默认位置，LLM 只选名字不写坐标"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "layer", "shape", "color", "width", "height"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "kind": { "const": "shape" },
              "layer": { "type": "integer", "minimum": 0 },
              "shape": { "type": "string", "enum": ["rect", "circle", "line", "arrow", "triangle", "star", "heart"] },
              "color": {
                "oneOf": [
                  { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  { "type": "string", "enum": ["primary", "accent", "text", "muted", "subtitle", "wash", "soft"] }
                ]
              },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "slot": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top_left", "top_right", "bottom_left", "bottom_right"],
                "default": "center",
                "description": "语义槽位：元素默认位置，LLM 只选名字不写坐标"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "layer", "emoji"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "kind": { "const": "emoji" },
              "layer": { "type": "integer", "minimum": 0 },
              "emoji": {
                "type": "string",
                "enum": ["sun", "cloud", "droplet", "leaf", "seedling", "light-bulb", "atom", "microscope", "telescope", "rocket", "globe", "star", "sparkles", "heart", "warning", "check", "cross", "question", "book", "brain", "dna", "battery", "gear", "magnifier", "fire", "snowflake", "wave"],
                "description": "内置 emoji 资产 id（Twemoji）"
              },
              "slot": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top_left", "top_right", "bottom_left", "bottom_right"],
                "default": "center",
                "description": "语义槽位：元素默认位置，LLM 只选名字不写坐标"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "layer", "asset"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "kind": { "const": "asset" },
              "layer": { "type": "integer", "minimum": 0 },
              "asset": {
                "type": "string",
                "minLength": 1,
                "description": "素材库条目 id（只能从提示词给出的可用素材库列表中选）"
              },
              "slot": {
                "type": "string",
                "enum": ["center", "top", "bottom", "left", "right", "top_left", "top_right", "bottom_left", "bottom_right"],
                "default": "center",
                "description": "语义槽位：元素默认位置，LLM 只选名字不写坐标"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "可选：显示宽度（缺省取素材库默认宽度）"
              }
            }
          }
        ]
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "on", "action", "durationMs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "on": {
            "type": "object",
            "additionalProperties": false,
            "required": ["narrationId", "anchor"],
            "properties": {
              "narrationId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "anchor": { "type": "string", "minLength": 1 }
            }
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "element"],
                "properties": {
                  "type": { "const": "appear" },
                  "element": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "at": { "type": "string", "enum": ["start", "anchor"], "default": "anchor" },
                  "preset": {
                    "type": "string",
                    "enum": ["fade", "pop", "slide_up", "slide_down", "slide_left", "slide_right", "zoom"],
                    "default": "fade",
                    "description": "入场动画预设"
                  },
                  "distancePx": { "type": "number", "exclusiveMinimum": 0, "default": 80, "description": "滑入距离（像素）" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "element"],
                "properties": {
                  "type": { "const": "disappear" },
                  "element": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "preset": {
                    "type": "string",
                    "enum": ["fade", "shrink"],
                    "default": "fade",
                    "description": "退场动画预设"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "element"],
                "properties": {
                  "type": { "const": "emphasize" },
                  "element": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1.2 },
                  "easing": { "type": "string", "enum": ["linear", "ease-in", "ease-out", "ease-in-out"], "default": "ease-out" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "element", "to"],
                "properties": {
                  "type": { "const": "move" },
                  "element": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "to": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$" },
                  "offsetX": { "type": "number", "default": 0 },
                  "offsetY": { "type": "number", "default": 0 },
                  "easing": { "type": "string", "enum": ["linear", "ease-in", "ease-out", "ease-in-out"], "default": "ease-in-out" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "element", "preset"],
                "properties": {
                  "type": { "const": "animate" },
                  "element": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "preset": {
                    "type": "string",
                    "enum": ["float", "shake", "bounce", "wiggle"],
                    "description": "氛围动画：float 漂浮 / shake 摇晃 / bounce 弹跳 / wiggle 摆动"
                  },
                  "easing": { "type": "string", "enum": ["linear", "ease-in", "ease-out", "ease-in-out"], "default": "ease-in-out" }
                }
              }
            ]
          },
          "durationMs": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
